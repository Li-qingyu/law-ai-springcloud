#应用基础配置
DEBUG=True

# 服务配置
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# 配置ai(使用ali系的)
DASHSCOPE_API_KEY=你的apikey阿里云中的
OPENAI_MODEL=qwen-plus
DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 嵌入模型配置
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSION=1024
# deepseek模型配置
DEEPSEEK_API_KEY=deepseek的apikey
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
# --- Milvus 向量数据库（与 Spring Boot 保持一致）---
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DATABASE_NAME=law_ai
MILVUS_COLLECTION_ARTICLES=law_articles
MILVUS_COLLECTION_CASES=law_cases
MILVUS_COLLECTION_HISTORY=consult_history
MILVUS_METRIC_TYPE=COSINE

# --- Redis 缓存 ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2
REDIS_PASSWORD=
REDIS_EXPIRE_TIME=86400

# -------------------- MySQL 数据库 --------------------
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=20060426
DB_DATABASE_NAME=law_consultation



# --- Agent 配置 ---
AGENT_MAX_ITERATIONS=10      # Agent 最大工具调用次数
TOOL_SCORE_THRESHOLD=0.63    # 向量检索相关度阈值
TOP_K_RESULTS=5            # 每次检索返回结果数